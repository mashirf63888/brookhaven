-- STATE
local busy = false
local hasAccess = false

local function checkGroup()
    local inGroup = false
    pcall(function()
        inGroup = player:IsInGroup(GROUP_ID)
    end)

    if inGroup then
        hasAccess = true
        LockIcon.Text = "✅"
        LockStroke.Color = Color3.fromRGB(0, 200, 120)
        Status.Text = "✅  Access granted!"
        Status.TextColor3 = Color3.fromRGB(0, 220, 140)
        StatusStroke.Color = Color3.fromRGB(0, 150, 80)
        JoinBtn.Visible = false

        task.wait(1.5)
        TweenService:Create(Blur, TweenInfo.new(0.4), {Size = 0}):Play()
        TweenService:Create(Main, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, -170, 1.5, 0),
            BackgroundTransparency = 1
        }):Play()
        task.wait(0.5)
        ScreenGui:Destroy()
    else
        hasAccess = false
        Status.Text = "❌  Not in group"
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusStroke.Color = Color3.fromRGB(150, 30, 30)
        JoinBtn.Visible = true
    end
end

task.spawn(function()
    while not hasAccess do
        task.wait(5)
        checkGroup()
    end
end)

JoinBtn.MouseButton1Click:Connect(function()
    if busy then return end
    busy = true

    local opened = false
    if typeof(openbrowser) == "function" then
        openbrowser(GROUP_LINK)
        opened = true
    elseif typeof(open_url) == "function" then
        open_url(GROUP_LINK)
        opened = true
    end

    if opened then
        Status.Text = "🌐  Opened in browser"
        Status.TextColor3 = Color3.fromRGB(0, 180, 255)
    else
        if typeof(setclipboard) == "function" then
            setclipboard(GROUP_LINK)
            Status.Text = "📋  Link copied!"
            Status.TextColor3 = Color3.fromRGB(0, 180, 255)
        else
            Status.Text = "⚠️  Copy link manually"
            Status.TextColor3 = Color3.fromRGB(255, 180, 0)
        end
    end

    task.wait(1)
    busy = false
end)

